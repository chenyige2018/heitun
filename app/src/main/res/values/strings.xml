<resources>
    <string name="app_name">豚链AI</string>
    <!-- APP 打开的网址，改这里即可 -->
    <string name="site_url">https://22.heitun.link/</string>

    <!-- 【2026-10-19】双品牌差异化配置（贝贝快聊在 app/src/beibei/res/values/strings.xml 覆盖） -->
    <!-- 更新检测地址：每个品牌各查各的，避免互相误报升级 -->
    <string name="update_check_url">https://22.heitun.link/version.json</string>
    <!-- 下载下来的更新包文件名 -->
    <string name="update_apk_name">tunlian-update.apk</string>
    <!-- WebView UA 标识 + 更新下载通知标题 -->
    <string name="ua_tag">TunLianApp</string>
    <string name="update_title">豚链AI更新</string>

    <!-- 【2026-10-04】原生会议页样式 -->
    <style name="MeetCtrl">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="MeetBtn">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_btn_dark</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="MeetBtnRed">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_btn_red</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="MeetLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">#C9CDD4</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
