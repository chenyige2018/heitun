<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f1620"
    android:orientation="vertical">

    <!-- 顶部：房间号 + 计时 + 返回 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#16202c"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:text="‹"
            android:textColor="#ffffff"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="会议"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#8fb7ff"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 视频宫格：本地画面 + 远端画面，两列自动排布 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridLayout
            android:id="@+id/gridVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="2"
            android:padding="0dp" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text=""
            android:textColor="#9aa7b5"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- 底部控制条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#16202c"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnMic"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="3dp"
            android:background="#22303f"
            android:text="静音"
            android:textColor="#ffffff"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCam"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="#22303f"
            android:text="关摄像头"
            android:textColor="#ffffff"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSpeaker"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="#22303f"
            android:text="扬声器"
            android:textColor="#ffffff"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnMembers"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="#22303f"
            android:text="成员"
            android:textColor="#ffffff"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#16202c"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="14dp">

        <Button
            android:id="@+id/btnRec"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="3dp"
            android:background="#2b4a6f"
            android:text="云录制"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnEnd"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="#8c2f2f"
            android:text="结束会议"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnLeave"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="6dp"
            android:background="#5a2530"
            android:text="离开"
            android:textColor="#ffffff"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
